# Database
DATABASE_URL=postgresql+psycopg://jobmail:jobmail@db:5432/jobmail

# LLM
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MODE=job_only

# Gmail
GMAIL_CREDENTIALS_FILE=secrets/gmail_client_secret.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_PUBSUB_TOPIC=
GMAIL_POLL_INTERVAL_SEC=60

# IMAP (JSON array of account configs)
# Example: [{"host":"imap.gmx.net","port":993,"user":"user@gmx.net","password":"app-password"}]
IMAP_ACCOUNTS=[]

# Logic
GHOSTING_DAYS=30
BACKFILL_MONTHS=6
LLM_MAX_BODY_CHARS=4000

# App
DEBUG=false
LOG_LEVEL=INFO
